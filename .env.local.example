# ============================================================
# DoesItExist — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real keys.
# NEVER commit .env.local to version control.
# ============================================================

# ── Core AI APIs ─────────────────────────────────────────────────────────────

# Tavily Search API — https://app.tavily.com/
# Used for live web search across Product Hunt, YC, and startup directories.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API — https://console.groq.com/
# Used for fast LLM synthesis (llama-3.1-8b-instant) with structured JSON output.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis (Phase 3 — Caching & Rate Limiting) ────────────────────────
# Create a free Upstash Redis database at: https://console.upstash.com/
# After creation, go to the database page → REST API → copy the values below.

# REST API URL (format: https://<your-db-name>.upstash.io)
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io

# REST API Token (long bearer token string)
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public Site URL (for OG image absolute paths & sitemap) ──────────────────
# In development this defaults to http://localhost:3000
# In production, set this to your actual domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://doesitexist.app
